# 企业信用评分卡 Agent —— LLM 环境配置示例
# 复制本文件为 .env 并填入真实 API key（.env 已被 .gitignore 排除，不会提交）

# 通用参数
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=30

# 密钥池（client 根据 preset 的 api_key_env 字段读取对应变量）
DASHSCOPE_API_KEY=your-dashscope-key

# 模型预设（单行 JSON array）
# provider="openai" 表示使用 OpenAI 兼容接口调用百炼
LLM_PRESETS=[{"label":"⚡ Qwen3.6 Max","provider":"openai","model":"qwen3.6-max-preview","base_url":"https://dashscope.aliyuncs.com/compatible-mode/v1","api_key_env":"DASHSCOPE_API_KEY"},{"label":"🧠 GLM 5.2","provider":"openai","model":"glm-5.2","base_url":"https://dashscope.aliyuncs.com/compatible-mode/v1","api_key_env":"DASHSCOPE_API_KEY"},{"label":"🔥 DeepSeek V4 Pro","provider":"openai","model":"deepseek-v4-pro-0813","base_url":"https://dashscope.aliyuncs.com/compatible-mode/v1","api_key_env":"DASHSCOPE_API_KEY"},{"label":"💎 DeepSeek V3.1","provider":"openai","model":"deepseek-v3.1","base_url":"https://dashscope.aliyuncs.com/compatible-mode/v1","api_key_env":"DASHSCOPE_API_KEY"},{"label":"🌙 Qwen3.5 397B","provider":"openai","model":"qwen3.5-397b-a17b","base_url":"https://dashscope.aliyuncs.com/compatible-mode/v1","api_key_env":"DASHSCOPE_API_KEY"}]

# 默认模型（去 emoji 后与 label 模糊匹配，大小写不敏感）
LLM_DEFAULT=Qwen3.6 Max
